# Cloudflare deploy (Wrangler). Copy to `.env` and fill in when ready to deploy.
# `.env` is gitignored; never commit real credentials.

# Cloudflare Account ID — Dashboard → Workers & Pages → sidebar, or
# the URL dash.cloudflare.com/<account_id>.
CLOUDFLARE_ACCOUNT_ID=

# API token with Workers + R2 permissions — Dashboard → My Profile → API Tokens.
# Alternative: run `npx wrangler login` and leave this empty.
CLOUDFLARE_API_TOKEN=
